{
  "name": "@senditapp/openai-plugin-release",
  "version": "1.1.0",
  "private": true,
  "description": "Build and validate the public SendIt plugin and standalone agent skill.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-plugin.mjs",
    "validate:submission": "node scripts/validate-plugin.mjs --submission",
    "validate:online": "node scripts/validate-plugin.mjs --online",
    "build": "node scripts/build-release.mjs",
    "test": "node --test scripts/*.test.mjs",
    "schemas:refresh": "node scripts/fetch-schemas.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fflate": "^0.8.2",
    "yaml": "^2.8.1"
  }
}
